{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 26,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "strict-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTING": "ON",
        "LMMC_BUILD_TESTS": "ON",
        "LMMC_BUILD_EXAMPLES": "OFF",
        "LMMC_WARNINGS_AS_ERRORS": "ON",
        "LMMC_ENABLE_SANITIZERS": "OFF",
        "LMMC_ENABLE_TSAN": "OFF",
        "LMMC_LMMP_ASM": "AUTO"
      }
    },
    {
      "name": "strict-debug",
      "displayName": "Strict LMMC test build",
      "inherits": "strict-base"
    },
    {
      "name": "linux-asan-ubsan",
      "displayName": "LMMC ASan/UBSan build",
      "inherits": "strict-base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "LMMC_ENABLE_SANITIZERS": "ON",
        "LMMC_LMMP_ASM": "GENERIC"
      }
    },
    {
      "name": "linux-tsan",
      "displayName": "LMMC TSan build",
      "inherits": "strict-base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "LMMC_ENABLE_TSAN": "ON",
        "LMMC_LMMP_ASM": "GENERIC"
      }
    },
    {
      "name": "package",
      "displayName": "Installable LMMC package",
      "inherits": "strict-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/build/package-install",
        "BUILD_TESTING": "OFF",
        "LMMC_BUILD_TESTS": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "strict-debug",
      "configurePreset": "strict-debug",
      "jobs": 2
    },
    {
      "name": "linux-asan-ubsan",
      "configurePreset": "linux-asan-ubsan",
      "jobs": 2
    },
    {
      "name": "linux-tsan",
      "configurePreset": "linux-tsan",
      "jobs": 2
    },
    {
      "name": "package",
      "configurePreset": "package",
      "jobs": 2,
      "targets": ["install"]
    }
  ],
  "testPresets": [
    {
      "name": "strict-debug",
      "configurePreset": "strict-debug",
      "output": { "outputOnFailure": true },
      "execution": { "jobs": 2, "timeout": 300 }
    },
    {
      "name": "linux-asan-ubsan",
      "configurePreset": "linux-asan-ubsan",
      "output": { "outputOnFailure": true },
      "execution": { "jobs": 2, "timeout": 300 },
      "environment": {
        "ASAN_OPTIONS": "detect_leaks=1:strict_string_checks=1",
        "UBSAN_OPTIONS": "print_stacktrace=1:halt_on_error=1"
      }
    },
    {
      "name": "linux-tsan",
      "configurePreset": "linux-tsan",
      "output": { "outputOnFailure": true },
      "execution": { "jobs": 2, "timeout": 300 },
      "environment": {
        "TSAN_OPTIONS": "halt_on_error=1:second_deadlock_stack=1"
      }
    }
  ]
}
